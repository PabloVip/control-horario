rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Uso propio con login anónimo: cualquier anónimo autenticado puede leer/escribir
    // Solo tus dispositivos (con tu firebaseConfig) conocen el proyecto.
    match /dias/{dia} {
      allow read, write: if request.auth != null;
    }
    match /meta/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
